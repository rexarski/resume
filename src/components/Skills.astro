---
// src/components/Skills.astro
interface SkillRow { category: string; items: string }
interface Props { rows: SkillRow[] }
const { rows } = Astro.props;
---
<div class="skills">
  {rows.map((r) => (
    <div class="row">
      <span class="cat">{r.category}</span>
      <span class="items">{r.items}</span>
    </div>
  ))}
</div>
